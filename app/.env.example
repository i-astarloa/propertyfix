# Copia este archivo como .env si quieres cambiar algo. Sin .env la app usa estos valores.

# Modelo de IA local servido por Ollama (gratis, sin clave de API)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# Puerto de la web
PROPERTYFIX_PORT=8000

# Cuenta de Google del proyecto: recibe las órdenes de trabajo dirigidas a proveedores (sandbox)
GOOGLE_ACCOUNT=proyectofinaldeeplearning@gmail.com

# Barandillas
MAX_TOKENS_PER_INCIDENT=20000
UMBRAL_GASTO_REFORZADO=1000

# Tarea en bucle: cada cuántos segundos se revisa la bandeja de Gmail (0 = desactivada)
INTERVALO_BUZON_S=120
