# Copia este archivo como .env y rellena los valores.

# Clave de la API de Anthropic (https://console.anthropic.com -> API Keys)
ANTHROPIC_API_KEY=

# Modo de las integraciones: "real" usa Gmail/Calendar/Sheets de verdad,
# "demo" usa servidores MCP simulados (la app arranca sin credenciales).
PROPERTYFIX_MODE=demo

# Cuenta de Google del proyecto (solo modo real)
GOOGLE_ACCOUNT=propertyfix.demo@gmail.com
GOOGLE_SHEET_ID=

# Límite de gasto por incidencia (barandilla)
MAX_TOKENS_PER_INCIDENT=60000
